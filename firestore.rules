rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidBookingRequest() {
      let data = request.resource.data;
      return data.customerName is string && data.customerName.size() > 0
          && data.customerPhone is string && data.customerPhone.size() >= 10
          && data.dateStr is string
          && data.status in ['PENDING', 'CONFIRMED', 'REJECTED'];
    }

    // Studio Profile: Publicly viewable, editable by owner
    match /studio_profile/{profileId} {
      allow read, write: if true;
    }

    // Available and booked dates: Publicly viewable, editable by studio app
    match /studio_date_slots/{slotId} {
      allow read, write: if true;
    }

    // Booking Requests: Anyone can submit an inquiry with valid fields; app manages them
    match /booking_requests/{requestId} {
      allow create: if isValidBookingRequest();
      allow read, update, delete: if true;
    }
  }
}
